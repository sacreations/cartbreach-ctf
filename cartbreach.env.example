# CartBreach local development environment
# Copy this file to cartbreach.env before starting the stack.
# These values are disposable CTF fixtures, not production credentials.

NODE_ENV=production
FLASK_ENV=production

# Database
POSTGRES_DB=cartbreach
POSTGRES_USER=cart_user
POSTGRES_PASSWORD=replace-with-local-db-password
DB_HOST=postgres-data
DB_PORT=5432

# Challenge service secrets
HMAC_KEY=replace-with-local-hmac-key
STAGING_TOKEN=replace-with-local-staging-token
INTERNAL_TOKEN=replace-with-local-internal-token

# Docker network ranges
PUBLIC_SUBNET=172.28.10.0/24
BACKEND_SUBNET=172.28.20.0/24
